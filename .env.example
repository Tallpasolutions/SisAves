# Supabase — projeto em https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Conexão direta ao Postgres — usada por scripts/sql.mjs (migrations e testes).
# O ref é o identificador do projeto, o que aparece na URL do dashboard.
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
# Opcional: sobrepõe o host do pooler, se o projeto mudar de região.
SUPABASE_DB_HOST=

# Reserva para o retorno do login (OAuth e links de e-mail) quando a
# requisição não traz cabeçalho `origin`. O QR do CRO NÃO sai daqui: ele usa o
# `host` da requisição, então o certificado carrega o domínio pelo qual foi
# aberto.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Portas de entrada. Só o valor exato `on` abre — falham fechadas, para erro
# de digitação trancar em vez de abrir.
#
# Enquanto o sistema está no ar apenas para teste, o endereço é público: sem
# isto, qualquer um com o link entrava com a conta Google ou criava conta em
# /cadastrar. ATENÇÃO: isto fecha o aplicativo, NÃO o Supabase — a tranca de
# verdade é desligar o provedor em Authentication -> Providers -> Google e
# marcar "Disable new user signups". Quem já tem conta continua entrando por
# e-mail e senha nas duas configurações.
LOGIN_GOOGLE=off
CADASTRO_ABERTO=off

# Conta de desenvolvimento usada por scripts/usuario-teste.mjs.
# A senha NUNCA volta para o código: ela esteve escrita no script, num
# repositório público, e quem achasse o repositório entrava na conta.
# Gere uma com: openssl rand -base64 18 | tr '+/' '-_'
EMAIL_USUARIO_TESTE=teste@sisaves.local
SENHA_USUARIO_TESTE=

# Mercado Pago — assinatura (fase 10)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
